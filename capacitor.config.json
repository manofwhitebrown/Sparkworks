{
  "appId": "com.sparkworks.game",
  "appName": "Sparkworks",
  "webDir": "dist",
  "backgroundColor": "#0B0E14",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#0B0E14",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "native",
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_spark",
      "iconColor": "#FFC857"
    }
  }
}
