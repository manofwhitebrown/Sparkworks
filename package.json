{
  "name": "sparkworks",
  "version": "0.1.0",
  "private": true,
  "description": "Sparkworks: a puzzle-roguelite about sparks and machines. HTML5 + Capacitor (Android).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --import ./tests/core-css-register.mjs --test \"tests/*.test.js\"",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:icons": "capacitor-assets generate --android --assetPath assets --iconBackgroundColor \"#0B0E14\" --iconBackgroundColorDark \"#0B0E14\" --splashBackgroundColor \"#0B0E14\" --splashBackgroundColorDark \"#0B0E14\" && python3 assets/make_icons.py --android-layers"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
